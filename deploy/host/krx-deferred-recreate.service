[Unit]
Description=krx-alpha deferred collector recreate after session
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/krx-alpha
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStartPost=/bin/bash %h/krx-alpha/deploy/host/krx-deferred-verify.sh
TimeoutStartSec=10min

[Install]
WantedBy=default.target
